# Copy to `.env.local` and fill in the keys you want to enable.

# --- Supabase (auth + subscriptions) ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# --- Stripe (Pro/Max payment links + webhooks) ---
# Pro Payment Link — must include ONLY the Pro price (one product per link).
NEXT_PUBLIC_STRIPE_PRO_PAYMENT_LINK=
# Max Payment Link — separate link with ONLY the Max price.
NEXT_PUBLIC_STRIPE_MAX_PAYMENT_LINK=
# Webhook handler uses the secret key to load subscription details.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Optional: map Stripe Price IDs to tiers (for webhooks). If unset, paid subs default to Pro.
STRIPE_PRICE_ID_PRO=
STRIPE_PRICE_ID_MAX=
# Optional: fallback base URL when Origin header is missing (e.g. local tooling).
NEXT_PUBLIC_SITE_URL=

# --- Humanizer LLM (optional) ---
# Used by /api/humanize. See that file's header comment for the
# drop-in OpenAI / Anthropic swap.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# --- External AI detection verification (optional, for Pro/Max tiers) ---
# Used by lib/detection/external.ts. When set, /api/detect with
# `deepScan: true` will blend these providers' scores into the result.
GPTZERO_API_KEY=
SAPLING_API_KEY=
